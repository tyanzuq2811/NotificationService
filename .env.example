# ==============================================================================
# ENTERPRISE NOTIFICATION SERVICE - CQRS ARCHITECTURE (.NET 8 + KAFKA + VUE 3)
# ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' and fill in your actual private credentials.
# ==============================================================================

# 1. Database Connections
MSSQL_SA_PASSWORD=YourStrong@Pass123
ConnectionStrings__SqlServer=Server=localhost,1433;Database=NotificationWriteDb;User Id=sa;Password=YourStrong@Pass123;TrustServerCertificate=True;MultipleActiveResultSets=True;
ConnectionStrings__MasterSqlServer=Server=localhost,1433;Database=master;User Id=sa;Password=YourStrong@Pass123;TrustServerCertificate=True;
ConnectionStrings__Mongo=mongodb://localhost:27017
ConnectionStrings__MongoDbName=read_db

# 2. Apache Kafka Broker & Topics
Kafka__BootstrapServers=localhost:9092
Kafka__NotificationEventsTopic=notification-events
Kafka__InAppPushTopic=inapp-push-events
Kafka__ConsumerGroupId=notification-consumer-group

# 3. Third-Party Dispatch Channels (Replace with your own credentials)
Channels__Email__SmtpHost=smtp.gmail.com
Channels__Email__SmtpPort=587
Channels__Email__SenderEmail=your_email@gmail.com
Channels__Email__SenderName=Hệ Thống Thông Báo Microservices
Channels__Email__Password=your_smtp_app_password
Channels__Telegram__BotToken=your_telegram_bot_token

# 4. Frontend Client Environment Variables (Vite)
VITE_COMMAND_BASE_URL=http://localhost:5001/api
VITE_QUERY_BASE_URL=http://localhost:5002/api
VITE_SIGNALR_HUB_URL=http://localhost:5002/hubs/notifications
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
